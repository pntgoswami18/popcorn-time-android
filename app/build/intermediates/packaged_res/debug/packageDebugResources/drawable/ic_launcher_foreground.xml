<?xml version="1.0" encoding="utf-8"?>
<!--
  Popcorn Time launcher icon foreground
  Classic design: white striped bucket with yellow popcorn kernels
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bucket body (white trapezoid, wider at top) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M24,52 L84,52 L75,85 L33,85 Z" />

    <!-- Red vertical stripes on bucket -->
    <path android:fillColor="#E53935"
        android:pathData="M34,52 L41,52 L37,85 L30,85 Z" />
    <path android:fillColor="#E53935"
        android:pathData="M51,52 L58,52 L55,85 L48,85 Z" />
    <path android:fillColor="#E53935"
        android:pathData="M68,52 L75,52 L72,85 L65,85 Z" />

    <!-- Bucket rim band (dark red) -->
    <path android:fillColor="#C62828"
        android:pathData="M22,47 L86,47 L86,54 L22,54 Z" />

    <!-- Popcorn kernels (circles as arc paths) -->
    <!-- Center-left puff cx=43 cy=37 r=11 -->
    <path android:fillColor="#FFF176"
        android:pathData="M43,37 m -11,0 a 11,11 0 1,0 22,0 a 11,11 0 1,0 -22,0" />
    <!-- Center-right puff cx=65 cy=37 r=11 -->
    <path android:fillColor="#FFF9C4"
        android:pathData="M65,37 m -11,0 a 11,11 0 1,0 22,0 a 11,11 0 1,0 -22,0" />
    <!-- Top-center puff cx=54 cy=24 r=10 -->
    <path android:fillColor="#FFFDE7"
        android:pathData="M54,24 m -10,0 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0" />
    <!-- Far-left puff cx=27 cy=44 r=8 -->
    <path android:fillColor="#FFF9C4"
        android:pathData="M27,44 m -8,0 a 8,8 0 1,0 16,0 a 8,8 0 1,0 -16,0" />
    <!-- Far-right puff cx=81 cy=44 r=8 -->
    <path android:fillColor="#FFF176"
        android:pathData="M81,44 m -8,0 a 8,8 0 1,0 16,0 a 8,8 0 1,0 -16,0" />

</vector>
